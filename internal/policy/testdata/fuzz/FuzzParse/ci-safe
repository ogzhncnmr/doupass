[]byte("version: \"0.1\"\nname: ci-safe\n\ndefaults:\n  action: deny\n  ask_fallback: deny\n\naudit:\n  path: \"~/.doupass/audit.jsonl\"\n  hash_chain: true\n\nrules:\n  - id: allow-read-tools\n    match:\n      surface: hook\n      tool: \"re:^(Read|Glob|Grep)$\"\n    action: allow\n    reason: \"Read-only tools are safe in CI\"\n\n  - id: allow-test-commands\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"re:^(go test|npm test|npm run test|pytest)\\b.*\"\n    action: allow\n    reason: \"Test commands are expected in CI\"\n\n  - id: allow-build-commands\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"re:^(go build|go vet|npm run build)\\b.*\"\n    action: allow\n    reason: \"Build commands are expected in CI\"\n\n  - id: deny-network\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"*curl*\"\n    action: deny\n    reason: \"CI jobs must not reach the network through the agent\"\n\n  - id: deny-writes\n    match:\n      tool: \"re:^(Write|Edit|NotebookEdit)$\"\n    action: deny\n    reason: \"CI jobs must not write files through the agent\"\n")
