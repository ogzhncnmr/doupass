[]byte("version: \"0.1\"\nname: starter\n\ndefaults:\n  action: allow\n  ask_fallback: deny\n  ask_timeout_seconds: 60\n\naudit:\n  path: \"~/.doupass/audit.jsonl\"\n  hash_chain: true\n\nrules:\n  - id: block-ssh-credentials\n    match:\n      args:\n        \"*\": \"**/.ssh/**\"\n    action: deny\n    reason: \"SSH keys and configs are off-limits\"\n\n  - id: block-aws-credentials\n    match:\n      args:\n        \"*\": \"**/.aws/**\"\n    action: deny\n    reason: \"AWS credentials are off-limits\"\n\n  - id: block-gcloud-credentials\n    match:\n      args:\n        \"*\": \"**/.config/gcloud/**\"\n    action: deny\n    reason: \"GCloud credentials are off-limits\"\n\n  - id: block-kubeconfig\n    match:\n      args:\n        \"*\": \"**/.kube/config\"\n    action: deny\n    reason: \"Kubernetes credentials are off-limits\"\n\n  - id: block-docker-config\n    match:\n      args:\n        \"*\": \"**/.docker/config.json\"\n    action: deny\n    reason: \"Registry credentials are off-limits\"\n\n  - id: block-git-credentials\n    match:\n      args:\n        \"*\": \"**/.git-credentials\"\n    action: deny\n    reason: \"Stored git credentials are off-limits\"\n\n  - id: block-npmrc\n    match:\n      args:\n        \"*\": \"**/.npmrc\"\n    action: deny\n    reason: \"npm tokens are off-limits\"\n\n  - id: block-env-files\n    match:\n      args:\n        \"*\": \"**/.env*\"\n    action: deny\n    reason: \"Environment files may contain secrets\"\n\n  - id: block-shadow-file\n    match:\n      args:\n        \"*\": \"**/etc/shadow\"\n    action: deny\n    reason: \"System credential file\"\n\n  - id: deny-rm-root\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"*rm -rf /*\"\n    action: deny\n    reason: \"Refusing recursive delete of root paths\"\n\n  - id: ask-rm-recursive\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"*rm -rf*\"\n    action: ask\n    reason: \"Recursive delete needs confirmation\"\n\n  - id: ask-package-install\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: re:.*(npm|yarn|pnpm|bun)\\s+(install|i|add)\\b.*|.*(pip3?|gem|cargo|go)\\s+install\\b.*\n    action: ask\n    reason: \"Package installs run lifecycle scripts\"\n\n  - id: ask-git-force-push\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: re:.*git\\s+push\\b.*(--force\\b|--force-with-lease\\b|\\s-f\\b).*\n    action: ask\n    reason: \"Force push may destroy remote history\"\n\n  - id: ask-curl-data\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"*curl*-d*\"\n    action: ask\n    reason: \"POSTing data with curl can exfiltrate files\"\n\n  - id: ask-base64-pipe\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: re:.*\\|\\s*base64\\b.*\n    action: ask\n    reason: \"Encoding data through a pipe is a common exfiltration step\"\n\n  - id: deny-drop-table\n    match:\n      args:\n        \"*\": \"*DROP TABLE*\"\n    action: deny\n    reason: \"Destructive SQL is not allowed\"\n\n  - id: deny-drop-database\n    match:\n      args:\n        \"*\": \"*DROP DATABASE*\"\n    action: deny\n    reason: \"Destructive SQL is not allowed\"\n\n  - id: allow-workspace\n    match:\n      args:\n        \"*\": \"${WORKSPACE}/**\"\n    action: allow\n    reason: \"Workspace access is expected\"\n")
