[]byte("version: \"0.1\"\nname: default-dev\n\ndefaults:\n  action: allow\n  ask_fallback: deny\n  ask_timeout_seconds: 60\n\naudit:\n  path: \"~/.doupass/audit.jsonl\"\n  hash_chain: true\n\nrules:\n  - id: block-ssh-credentials\n    match:\n      args:\n        \"*\": \"**/.ssh/**\"\n    action: deny\n    reason: \"SSH credentials are off-limits\"\n\n  - id: block-aws-credentials\n    match:\n      args:\n        \"*\": \"**/.aws/**\"\n    action: deny\n    reason: \"AWS credentials are off-limits\"\n\n  - id: block-env-files\n    match:\n      args:\n        \"*\": \"**/.env*\"\n    action: deny\n    reason: \"Environment files may contain secrets\"\n\n  - id: block-kubeconfig\n    match:\n      args:\n        \"*\": \"**/.kube/config\"\n    action: deny\n    reason: \"Kubernetes credentials are off-limits\"\n\n  - id: ask-npm-install\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"*npm install*\"\n    action: ask\n    reason: \"Package installs run lifecycle scripts\"\n\n  - id: ask-git-force-push\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"*git push*--force*\"\n    action: ask\n    reason: \"Force push may destroy remote history\"\n\n  - id: deny-rm-root\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"*rm -rf /*\"\n    action: deny\n    reason: \"Refusing recursive delete of root paths\"\n\n  - id: ask-rm-recursive\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"*rm -rf*\"\n    action: ask\n    reason: \"Recursive delete needs confirmation\"\n\n  - id: ask-curl-data\n    match:\n      surface: hook\n      tool: Bash\n      args:\n        command: \"*curl*-d*\"\n    action: ask\n    reason: \"POSTing data with curl can exfiltrate files\"\n\n  - id: deny-drop-table\n    match:\n      args:\n        \"*\": \"*DROP TABLE*\"\n    action: deny\n    reason: \"Destructive SQL is not allowed\"\n\n  - id: allow-workspace\n    match:\n      args:\n        \"*\": \"${WORKSPACE}/**\"\n    action: allow\n    reason: \"Workspace access is expected\"\n")
